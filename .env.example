# ============================================================
#  GTC Dashboard de Planeacion — plantilla de configuracion
# ------------------------------------------------------------
#  Copia este archivo a .env (cp .env.example .env) y rellena.
#  TODA la configuracion se lee de aqui; el codigo NO tiene
#  ningun valor de conexion hardcoded.
# ============================================================

# ---- Conexion a la base de datos donde corre el WF de n8n ----
# Servidor MySQL/MariaDB. Soportado MySQL 5.7+, MySQL 8, MariaDB 10.x.
# Escenario A: MySQL en otro contenedor de la misma red docker -> nombre del servicio (ej: mysql)
# Escenario B: MySQL en el host (Windows/Mac) -> host.docker.internal
# Escenario C: MySQL remoto (Stable/AWS/etc.) -> IP publica o hostname
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Nombre real de la BD. #colocar credenciales
DB_NAME=

# ---- Servidor HTTP del dashboard ----
PORT=8011
# Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# true solo si el dashboard esta detras de HTTPS (nginx/caddy/cloudflare).
# false si esta en HTTP plano (LAN o pruebas internas).
COOKIE_SECURE=false

# Confiar en el X-Forwarded-For del proxy. Se deja VACIO casi siempre: por
# defecto sigue a COOKIE_SECURE, porque ambos describen el mismo hecho — hay
# un proxy que termina TLS delante. Solo se pone a mano en el caso raro de un
# proxy SIN https.
#
# OJO: activarlo sin un proxy delante es PEOR que no tenerlo. El header pasa
# a ponerlo el cliente, asi que el limitador de login por IP deja de servir:
# basta rotar la cabecera para no agotar nunca el contador (comprobado; ver
# el comentario de trust proxy en server.js). El limite por cuenta sigue en
# pie, porque ese sale del cuerpo y no se puede falsificar.
TRUST_PROXY=

# ---- Jornada laboral GTC (44h/semana) ----
# Lunes 8h, Martes a Viernes 9h cada uno. Festivos descontados via mp_holidays.
WORK_HOURS_MONDAY=8
WORK_HOURS_TUE_FRI=9

# ---- Microsoft Graph (SharePoint) — Bloque 5 ----
# App registration con permisos Sites.ReadWrite.All (application). Reusar la
# misma del WF1 de n8n.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Opcional — si no se define usa el site/folder por defecto de GTC:
#   site = <SITE_ID_SHAREPOINT> #colocar credenciales
#   root = "Planeación 2026"
SHAREPOINT_SITE_ID=
SHAREPOINT_ROOT_FOLDER=
# Path relativo desde la raíz del drive al .xlsx plantilla. Debe existir.
# Ej: SHAREPOINT_TEMPLATE_PATH=Planeación 2026/Plantillas/Template.xlsx
SHAREPOINT_TEMPLATE_PATH=

# ---- Correo saliente (alertas de Costeo por HTML) ----
# Mientras estos campos esten vacios, el envio queda APAGADO: el endpoint
# responde diciendo que falta y el script pide usar --previsualizar. Nada se
# cae por no tener credenciales.
#   Office 365:  smtp.office365.com  puerto 587
#   Gmail/Workspace: smtp.gmail.com  puerto 587 (con contrasena de aplicacion)
SMTP_HOST=
# Opcional, normalmente se deja vacio. Solo si el certificado TLS del
# servidor esta emitido a nombre de OTRO host — pasa con Brevo tras su
# cambio de marca: el DNS interno de Docker resuelve smtp-relay.brevo.com
# pero no smtp-relay.sendinblue.com, y el certificado cubre el segundo y no
# el primero. Se conecta al que resuelve y se valida contra el que cubre:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_TLS_SERVERNAME=smtp-relay.sendinblue.com
# NO desactiva la verificacion: un certificado vencido o falso sigue fallando.
SMTP_TLS_SERVERNAME=
SMTP_PORT=587
# true solo si el puerto es 465 (SMTPS). En 587 y 25 se deja false: se usa
# STARTTLS, que se negocia solo.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ve quien recibe. Ej: GTC Costeo <costeo@empresa.com> #colocar credenciales
MAIL_FROM=
# Destinatario(s) por defecto del envio automatico, separados por coma.
# El endpoint acepta ademas un destinatario puntual en el cuerpo (`to`).
# Es quien recibe el correo del CEO: lo que ya escalo, 6 dias o mas.
ALERTAS_EMAIL_TO=
# Envio diario de la VENTANA DEL PM (las de 3 a 5 dias, las que todavia
# estan en sus manos). Los dos son necesarios para que ese correo exista; si
# falta cualquiera, simplemente no se manda — no es un error.
#   ALERTAS_PM_LIDER: correo del PM en mp_project_owners. Define QUE alertas
#                     entran: solo las de los proyectos activos de esa persona.
#   ALERTAS_PM_TO:    a donde se manda ese correo (puede ser otro distinto).
ALERTAS_PM_LIDER=
ALERTAS_PM_TO=
# URL publica del dashboard, para el boton "Abrir el panel de Alertas" del
# correo. Sin esto el correo sale igual, solo que sin boton.
APP_URL=
